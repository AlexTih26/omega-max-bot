# Секреты и окружение
.env
.env.local
.env copy

# Python
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache

# Логи и ОС
*.log
.DS_Store

# База комментариев (бинарник — не в Git)
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
data/*.sqlite3
data/taksimo.db
data/taksimo.db-*

# Бэкапы БД (только на сервере)
