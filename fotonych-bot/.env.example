MAX_BOT_TOKEN=your_max_bot_token_here
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4.1-mini
SYSTEM_PROMPT=Ты OMEGA — AI-помощник в MAX. Отвечай по-русски.
SITE_URL=https://max.avtmsk.ru
COMMENTS_PORT=8765
MAX_BOT_USERNAME=id5406829253_bot

# Отдельный браузерный кабинет бухгалтеров РУМЕКС. Задайте реальные PIN только
# в боевом .env; без всех трёх записей и секрета доступ остаётся закрыт.
RUMEX_ACCOUNTANT_USERS=Бухгалтер 1:PIN_1,Бухгалтер 2:PIN_2,Бухгалтер 3:PIN_3
RUMEX_ACCOUNTANT_AUTH_SECRET=replace_with_a_long_random_secret
RUMEX_REGISTRY_TIMEZONE=Asia/Irkutsk

# Отдельный парольный вход в изолированный тестовый кабинет диспетчера РУМЕКС.
# MAX ID определяет только видимость кнопки в боте. Учётные записи не дают
# доступа к Таксимо или кабинету бухгалтера. Без паролей и секрета кабинет закрыт.
RUMEX_TEST_DISPATCHER_USERS=Алексей:replace_with_a_unique_long_password
RUMEX_TEST_DISPATCHER_AUTH_SECRET=replace_with_another_long_random_secret

# Отдельный кабинет управления РУМЕКС: доступ к нему получают только
# MAX-супер-администраторы, а операции со сменой паролей и блокировками требуют
# дополнительный PIN. Не используйте PIN бухгалтеров или диспетчеров.
RUMEX_ADMIN_AUTH_SECRET=replace_with_a_third_long_random_secret
RUMEX_ADMIN_STEP_UP_PIN=replace_with_a_separate_long_pin
